generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LogEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique
  requestId String
  type      String
  service   String
  timestamp BigInt
  payload   Json
  createdAt DateTime @default(now())
}
